# Copy to .env for local dev (never commit .env)
# Railway: set these in the project Variables UI (same names)

OPENAI_API_KEY=your_openai_api_key_here
# Optional — defaults are set in server.js if unset
OPENAI_TEXT_MODEL=gpt-40-mini
OPENAI_IMAGE_CONTROLLER_MODEL=gpt-40
PORT=3000

# Split deploy only: GitHub Pages frontend calling Railway API
# Comma-separated origins, e.g. https://yourname.github.io,https://yourname.github.io/your-repo
ALLOWED_ORIGINS=

# Optional — Steel browser (for AI agent web tasks over CDP)
STEEL_API_KEY=your_steel_api_key_here
# Optional
STEEL_PROJECT_ID=
# Optional
STEEL_WS_ENDPOINT=wss://connect.steel.dev
