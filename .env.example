# Copy to .env for local dev (never commit .env)
# Railway: set these in the project Variables UI (same names)

OPENAI_API_KEY=your_openai_api_key_here
# Optional — defaults are set in server.js if unset
OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_IMAGE_CONTROLLER_MODEL=gpt-image-1
PORT=3000

# Rate limits (requests per window)
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=60
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=20
STEEL_RATE_LIMIT_WINDOW_MS=60000
STEEL_RATE_LIMIT_MAX=5

# Split deploy only: GitHub Pages frontend calling Railway API
# Comma-separated origins, e.g. https://yourname.github.io,https://yourname.github.io/your-repo
ALLOWED_ORIGINS=

# Optional — Steel browser (for AI agent web tasks over CDP)
STEEL_API_KEY=your_steel_api_key_here
# Optional
STEEL_PROJECT_ID=
# Optional
STEEL_WS_ENDPOINT=wss://connect.steel.dev
# Required for steel navigate endpoint: comma-separated hostnames only (no scheme)
STEEL_ALLOWED_HOSTS=example.com,www.example.com
# Optional hardening for steel endpoints (recommended in production)
ENABLE_STEEL_AGENT=false
STEEL_AGENT_TOKEN=replace_with_long_random_token
