PORT=3000
NODE_ENV=development

# --- AI Provider Selection ---
# Supported: gemini | openai | local
AI_PROVIDER=gemini
AI_DISABLED=false
AI_ENABLE_STORY=true
AI_ENABLE_THEME=true
AI_FALLBACK_MODE=local
AI_DEBUG=false

# --- Gemini (recommended free-first provider) ---
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash-lite
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image-preview

# --- OpenAI (optional alternative provider) ---
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_IMAGE_CONTROLLER_MODEL=gpt-5

# --- Brave grounding (optional, with your Brave key) ---
BRAVE_SEARCH_API_KEY=
BRAVE_GROUNDING_ENABLED=true
BRAVE_GROUNDING_MAX_TOKENS=4096
BRAVE_GROUNDING_MAX_URLS=8
BRAVE_SEARCH_LANG=en
BRAVE_COUNTRY=us

# --- CORS (comma-separated origins; leave empty for same-origin only) ---
ALLOWED_ORIGINS=

# --- Client runtime defaults (sound/music/voice/animations/video) ---
DEFAULT_SOUND_ENABLED=true
DEFAULT_MUSIC_ENABLED=false
DEFAULT_VOICE_GUIDE_ENABLED=false
DEFAULT_ANIMATIONS_ENABLED=true
DEFAULT_BONUS_VIDEO_ENABLED=true
HONOR_PREFERS_REDUCED_MOTION=true

# Optional custom bonus video URLs
BONUS_VIDEO_URL_WEBM=
BONUS_VIDEO_URL_MP4=
